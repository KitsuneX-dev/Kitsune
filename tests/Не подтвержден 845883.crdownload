    ("getattr((), f'__class__')", "__class__"),
    ("def f(): pass\ngetattr(f, '__code__')", "__code__"),
    ("def f(): pass\ngetattr(f, 'func_code')", "func_code"),
    ("def f(): pass\ngetattr(f, '__closure__')", "__closure__"),
    ("def f(obj): return getattr(obj, '__self__')", "__self__"),
    ("def f(obj): return getattr(obj, '__func__')", "__func__"),
])
