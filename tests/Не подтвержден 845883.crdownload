def _soft_scan(src):
    import ast as _ast
    from kitsune.core.loader import _ASTScanner, _scan_ast

    scanner = _ASTScanner()
    scanner.visit(_ast.parse(src))
    assert scanner.errors == []
    _scan_ast(src)
    return scanner.soft_findings


def test_scan_ast_confirms_shutil_rmtree():
    findings = _soft_scan("import shutil\nshutil.rmtree('/tmp/x')")
    assert any("rmtree" in f for f in findings)


def test_scan_ast_confirms_shutil_rmtree_via_alias():
    findings = _soft_scan("import shutil as sh\nsh.rmtree('/tmp/x')")
    assert any("rmtree" in f for f in findings)


def test_scan_ast_allows_os_remove_and_unlink():
    assert _soft_scan("import os\nos.remove('/tmp/x')") == []
    assert _soft_scan("import os\nos.unlink('/tmp/x')") == []


def test_scan_ast_confirms_from_shutil_import_rmtree():
    findings = _soft_scan("from shutil import rmtree")
    assert any("rmtree" in f for f in findings)


def test_scan_ast_allows_from_os_import_remove():
    assert _soft_scan("from os import remove") == []


def test_scan_ast_warns_on_sensitive_open_without_blocking():
    import ast
    from kitsune.core import loader as ld
    for src in (
        "f = open('/home/u/kitsune.session')",
        "f = open('data/kitsune.key')",
        "f = open('config.toml')",
        "name = 'x'\nf = open(f'{name}/config.toml')",
    ):
        ld._scan_ast(src)
        scanner = ld._ASTScanner()
        scanner.visit(ast.parse(src))
        assert scanner.warnings
        assert not scanner.errors


def test_scan_ast_allows_plain_open_and_safe_shutil():
    import ast
    from kitsune.core import loader as ld
    src = "import shutil\nshutil.copy('a', 'b')\nwith open('/tmp/data.txt') as f:\n    pass\n"
    ld._scan_ast(src)
    scanner = ld._ASTScanner()
    scanner.visit(ast.parse(src))
    assert not scanner.warnings


